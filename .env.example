# Public HTTPS origin of this deployed service. No trailing slash.
PAPERFLOW_PUBLIC_BASE_URL=https://paperflow.example.com
# Persistent disk location. Mount /data in Docker/your PaaS.
PAPERFLOW_DATA_DIR=/data
# Optional explicit sqlite path.
# PAPERFLOW_DB_PATH=/data/paperflow.sqlite3
PAPERFLOW_HOST=0.0.0.0
